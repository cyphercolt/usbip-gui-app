# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
.eggs/

# PyInstaller build artifacts (keep .spec files but ignore executables)
USB-IP-GUI
USB-IP-GUI.exe
USB-IP-GUI-Linux/
USB-IP-GUI-Windows/
*.tar.gz
*.zip

# Virtual environments
venv/
ENV/
env/
.venv/
.virtualenv/

# OS files
.DS_Store
Thumbs.db
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini

# Application state files (encrypted and plaintext)
*.enc
*.json
*.json.backup
ssh_state.*
usbip_state.*
ips.*

# Security test artifacts
test_security_*.txt
security_test_*

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject

# Logs and temporary files
*.log
*.tmp
*.temp
.cache/
logs/

# Package manager files
pip-log.txt
pip-delete-this-directory.txt

# pytest cache
.pytest_cache/

# Test files and folders
tests/

# Coverage reports
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# Environment variables
.env
.env.local
.env.*.local

# System and runtime files
*.pid
*.sock
usbip-gui-app.code-workspace

# --- v3 rewrite: node service + web app ---
# Build/deps we don't commit
web/node_modules/
web/dist/
node/.venv/
node/build/
node/*.egg-info/
# Local node runtime state (identity + trust store)
.usbip-node-state/
node/.usbip-node-state/

# TypeScript incremental build info
*.tsbuildinfo

# Re-include files the broad rules above would wrongly drop (but not their build artifacts)
!node/tests/
!node/tests/*.py
!web/package.json
!web/package-lock.json
!web/tsconfig.json
!web/tsconfig.node.json
